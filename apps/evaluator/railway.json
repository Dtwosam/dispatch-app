{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install && npm --workspace packages/shared run build && npm --workspace apps/evaluator run build"
  },
  "deploy": {
    "startCommand": "npm --workspace apps/evaluator run start",
    "healthcheckPath": "/health",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
